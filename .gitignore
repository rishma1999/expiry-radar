# =============================================================================
# .gitignore - Expiry Radar
# =============================================================================
# ⚠  CRITICAL: IBM Cloud security monitoring is active on this repository.
#    Committing API keys, tokens, or passwords WILL trigger account suspension.
#    Do NOT remove the credential sections below under any circumstances.
# =============================================================================

# ── IBM Cloud & Watson credentials ───────────────────────────────────────────
ibm-credentials.env
ibmcloud-*.json
ibm-cloud-api-key.txt
service_credentials*.json
vcap-services*.json
apikey.txt
api_key.txt
.ibmcloud/

# ── Generic secrets & environment files ──────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.staging
*.env

# ── Key files & certificates ─────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
*.cer
*.crt
*.csr
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_dsa
id_dsa.*
*.ppk
secrets.yaml
secrets.yml
secrets.json
*secrets*
*secret*
*credential*

# ── GitHub / CI tokens ───────────────────────────────────────────────────────
.github-token
github_token.txt
GITHUB_TOKEN

# ── Auth & config files that may embed tokens ────────────────────────────────
.netrc
.curlrc
.npmrc
.pypirc
.docker/config.json
config/database.yml
database.yml

# ── Expiry Radar - pipeline output (local scan artifacts, not source) ─────────
# Regenerated by collectors; contain local absolute paths. Never commit.
candidates.json
eol_candidates.json
eol_findings.json
deprecation_findings.json
issue_candidates.json
issue_findings.json
todo_findings.json
todo_analysis.json
scored_findings.json
findings.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/
.env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Testing & coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor noise ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── Large / binary assets ────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz
